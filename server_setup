#!/usr/bin/env bash
set -euo pipefail

RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
BLUE=$'\033[34m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

info() { echo "${BLUE}==>${RESET} $*"; }
ok() { echo "${GREEN}OK:${RESET} $*"; }
warn() { echo "${YELLOW}WARN:${RESET} $*"; }
err() { echo "${RED}ERROR:${RESET} $*" >&2; }

PROVIDERS_DIR="/etc/opk"
PROVIDERS_FILE="/etc/opk/providers"
AUTH_ID_FILE="/etc/opk/auth_id"

UGA_ISSUER="https://login.microsoftonline.com/a8216c1e-4d63-4352-8c3b-50fa1f1475b1/v2.0"
UGA_CLIENT_ID="7f331a0a-da1a-4e13-8df0-e9baba02ed86"
UGA_TTL="12h"
UGA_PROVIDER_LINE="${UGA_ISSUER} ${UGA_CLIENT_ID} ${UGA_TTL}"

INSTALL_URL="https://raw.githubusercontent.com/openpubkey/opkssh/main/scripts/install-linux.sh"

PROVIDERS_ONLY=false
CONFIGURE_JUMP_HOST=false
CONFIGURE_GITEA_OPKSSH=false
GROUP_MAP=""
ROLE_MAP=""
EMAIL_MAP=""
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUTH_SYNC_SCRIPT="$SCRIPT_DIR/scripts/living_labs_auth_sync"
SSHD_CONFIG_DIR="/etc/ssh/sshd_config.d"
SSHD_OPKSSH_CONFIG="$SSHD_CONFIG_DIR/50-opkssh.conf"
SSHD_JUMP_CONFIG="$SSHD_CONFIG_DIR/60-uga-living-labs-jump.conf"
NO_SHELL_SOURCE_SCRIPT="$SCRIPT_DIR/scripts/factory_ssh_no_shell"
NO_SHELL_INSTALL_PATH="/usr/local/libexec/uga-living-labs/factory-ssh-no-shell"
GITEA_BRIDGE_SOURCE_SCRIPT="$SCRIPT_DIR/scripts/gitea_opkssh_authorized_keys"
GITEA_BRIDGE_INSTALL_PATH="/usr/local/libexec/uga-living-labs/gitea-opkssh-authorized-keys"
GITEA_BRIDGE_CONFIG="/etc/opk/gitea-opkssh.env"
GITEA_URL="http://127.0.0.1:3000"
GITEA_TOKEN_FILE="/etc/opk/gitea-token"
GITEA_BINARY=""
GITEA_CONFIG="/etc/gitea/app.ini"
GITEA_WORK_PATH=""
GITEA_RUN_USER="git"
GITEA_ACCESS_ROLE="factory-ssh-access"
GITEA_ACCESS_ROLE_SET=false
GITEA_REQUIRE_VERIFIED_EMAIL=true
GITEA_SYNTHETIC_KEY_READ_ONLY=false
JUMP_PRINCIPALS="factory"
PERMIT_OPEN="any"
FACTORY_USER="factory"
FACTORY_ACCESS_GROUP="factory-ssh-access"
INSTALL_NO_SHELL_COMMAND=true
CREATE_FACTORY_USER=true
CONFIGURE_SSHD_OPKSSH=true
CLIENT_ALIVE_INTERVAL="30"
CLIENT_ALIVE_COUNT_MAX="20"

usage() {
  echo "${BOLD}Usage:${RESET} $0 [options]"
  echo
  echo "Options:"
  echo "  -p, --providers-only       Only install/update providers file (skip opkssh install)"
  echo "  --no-sshd-opkssh           Do not configure sshd AuthorizedKeysCommand"
  echo "  --configure-jump-host      Add sshd_config.d snippet for ssh -J forwarding"
  echo "  --factory-user USER        Shared bastion username (default: factory)"
  echo "  --factory-access-group ID  Entra group/role claim for factory user (default: factory-ssh-access)"
  echo "  --no-create-factory-user   Do not create the shared bastion Unix user"
  echo "  --configure-gitea-opkssh   Enable dynamic OPKSSH-to-Gitea Git SSH auth bridge"
  echo "  --gitea-url URL            Local Gitea base URL (default: http://127.0.0.1:3000)"
  echo "  --gitea-token-file FILE    Gitea admin API token file (default: /etc/opk/gitea-token)"
  echo "  --gitea-binary PATH        Gitea binary path (default: auto-detect)"
  echo "  --gitea-config FILE        Gitea app.ini path (default: /etc/gitea/app.ini)"
  echo "  --gitea-work-path DIR      Optional Gitea work path"
  echo "  --gitea-run-user USER      Unix SSH user used by Gitea (default: git)"
  echo "  --gitea-access-role ID     Entra role claim allowed to authenticate as git (default: factory-ssh-access)"
  echo "  --gitea-allow-unverified-email  Allow matching unverified Gitea email records"
  echo "  --gitea-synthetic-read-only     Create synthetic Gitea key records as read-only"
  echo "  --jump-principals LIST     Space/comma separated users allowed to forward (default: factory)"
  echo "  --permit-open LIST         PermitOpen value for jump users (default: any)"
  echo "  --client-alive-interval N  Seconds between server keepalives for jump users (default: 30)"
  echo "  --client-alive-count N     Missed keepalives before disconnect (default: 20)"
  echo "  --no-no-shell-command      Do not install ForceCommand no-shell message"
  echo "  --group-map FILE           Apply Entra group-to-Linux-user auth map"
  echo "  --role-map FILE            Apply OIDC role-to-Linux-user auth map"
  echo "  --email-map FILE           Apply email/sub-to-Linux-user auth map"
  echo "  -h, --help                 Show this help message"
  echo
  echo "Examples:"
  echo "  sudo $0"
  echo "  sudo $0 --providers-only"
  echo "  sudo $0 --configure-jump-host --group-map examples/entra_groups.tsv"
}

# --- Parse args ---
while [[ $# -gt 0 ]]; do
  case "$1" in
  -p | --providers-only)
    PROVIDERS_ONLY=true
    shift
    ;;
  --no-sshd-opkssh)
    CONFIGURE_SSHD_OPKSSH=false
    shift
    ;;
  --configure-jump-host)
    CONFIGURE_JUMP_HOST=true
    shift
    ;;
  --factory-user)
    FACTORY_USER="${2:-}"
    JUMP_PRINCIPALS="${2:-}"
    shift 2
    ;;
  --factory-access-group)
    FACTORY_ACCESS_GROUP="${2:-}"
    if [[ "$GITEA_ACCESS_ROLE_SET" == false ]]; then
      GITEA_ACCESS_ROLE="${2:-}"
    fi
    shift 2
    ;;
  --no-create-factory-user)
    CREATE_FACTORY_USER=false
    shift
    ;;
  --configure-gitea-opkssh)
    CONFIGURE_GITEA_OPKSSH=true
    shift
    ;;
  --gitea-url)
    GITEA_URL="${2:-}"
    shift 2
    ;;
  --gitea-token-file)
    GITEA_TOKEN_FILE="${2:-}"
    shift 2
    ;;
  --gitea-binary)
    GITEA_BINARY="${2:-}"
    shift 2
    ;;
  --gitea-config)
    GITEA_CONFIG="${2:-}"
    shift 2
    ;;
  --gitea-work-path)
    GITEA_WORK_PATH="${2:-}"
    shift 2
    ;;
  --gitea-run-user)
    GITEA_RUN_USER="${2:-}"
    shift 2
    ;;
  --gitea-access-role)
    GITEA_ACCESS_ROLE="${2:-}"
    GITEA_ACCESS_ROLE_SET=true
    shift 2
    ;;
  --gitea-allow-unverified-email)
    GITEA_REQUIRE_VERIFIED_EMAIL=false
    shift
    ;;
  --gitea-synthetic-read-only)
    GITEA_SYNTHETIC_KEY_READ_ONLY=true
    shift
    ;;
  --jump-principals)
    JUMP_PRINCIPALS="${2:-}"
    shift 2
    ;;
  --permit-open)
    PERMIT_OPEN="${2:-}"
    shift 2
    ;;
  --client-alive-interval)
    CLIENT_ALIVE_INTERVAL="${2:-}"
    shift 2
    ;;
  --client-alive-count)
    CLIENT_ALIVE_COUNT_MAX="${2:-}"
    shift 2
    ;;
  --no-no-shell-command)
    INSTALL_NO_SHELL_COMMAND=false
    shift
    ;;
  --group-map)
    GROUP_MAP="${2:-}"
    shift 2
    ;;
  --role-map)
    ROLE_MAP="${2:-}"
    shift 2
    ;;
  --email-map)
    EMAIL_MAP="${2:-}"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    err "Unknown argument: $1"
    echo
    usage
    exit 1
    ;;
  esac
done

if [[ "${EUID}" -ne 0 ]]; then
  err "This script must be run as root."
  echo "Try:"
  echo "  sudo $0"
  exit 1
fi

# --- Install OPKSSH server unless providers-only ---
if [[ "$PROVIDERS_ONLY" == false ]]; then
  info "Checking platform"

  OS="$(uname -s)"
  ARCH="$(uname -m)"

  if [[ "$OS" != "Linux" ]]; then
    err "This script only auto-installs OPKSSH SERVER on Linux."
    echo
    echo "${BOLD}Install the OPKSSH SERVER version manually from:${RESET}"
    echo "  https://github.com/openpubkey/opkssh"
    exit 1
  fi

  if [[ "$ARCH" != "x86_64" ]]; then
    warn "Detected architecture: $ARCH (auto-install only supports x86_64)"
    echo
    echo "${BOLD}Install the OPKSSH SERVER version manually from:${RESET}"
    echo "  https://github.com/openpubkey/opkssh"
    exit 1
  fi

  ok "Detected Linux x86_64"

  if command -v opkssh >/dev/null 2>&1; then
    ok "opkssh already exists at: $(command -v opkssh)"
  else
    info "Installing OPKSSH SERVER version to /usr/local/bin/opkssh"

    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "$INSTALL_URL" | bash
    elif command -v wget >/dev/null 2>&1; then
      wget -qO- "$INSTALL_URL" | bash
    else
      err "Neither curl nor wget is installed."
      echo
      echo "${BOLD}Install OPKSSH SERVER manually:${RESET}"
      echo "  https://github.com/openpubkey/opkssh"
      exit 1
    fi

    if command -v opkssh >/dev/null 2>&1; then
      ok "Installed opkssh at: $(command -v opkssh)"
    else
      err "Installer ran, but opkssh still not found."
      exit 1
    fi
  fi
else
  warn "Running in providers-only mode. Skipping OPKSSH installation checks."
fi

# --- sshd OPKSSH verifier setup ---
if [[ "$CONFIGURE_SSHD_OPKSSH" == true ]]; then
  info "Configuring sshd OPKSSH verifier"

  if ! getent group opksshuser >/dev/null 2>&1; then
    if command -v groupadd >/dev/null 2>&1; then
      groupadd --system opksshuser
      ok "Created group: opksshuser"
    else
      err "groupadd was not found. Create group 'opksshuser' manually or rerun with --no-sshd-opkssh."
      exit 1
    fi
  fi

  if ! id opksshuser >/dev/null 2>&1; then
    if command -v useradd >/dev/null 2>&1; then
      useradd --system --no-create-home --shell /usr/sbin/nologin --gid opksshuser opksshuser
      ok "Created user: opksshuser"
    else
      err "useradd was not found. Create user 'opksshuser' manually or rerun with --no-sshd-opkssh."
      exit 1
    fi
  fi

  if command -v opkssh >/dev/null 2>&1; then
    OPKSSH_PATH="$(command -v opkssh)"
  else
    err "opkssh is not on PATH; cannot configure AuthorizedKeysCommand."
    exit 1
  fi

  install -d -m 755 "$SSHD_CONFIG_DIR"

  if [[ "$CONFIGURE_GITEA_OPKSSH" == true ]]; then
    info "Installing Gitea OPKSSH AuthorizedKeysCommand bridge"

    if ! id "$GITEA_RUN_USER" >/dev/null 2>&1; then
      err "Gitea SSH user '$GITEA_RUN_USER' does not exist. Create it or pass --gitea-run-user."
      exit 1
    fi

    if command -v usermod >/dev/null 2>&1; then
      usermod -a -G opksshuser "$GITEA_RUN_USER"
      ok "Allowed $GITEA_RUN_USER to read OPKSSH config through group opksshuser"
    else
      warn "usermod was not found. Ensure '$GITEA_RUN_USER' can read /etc/opk files through group opksshuser."
    fi

    if [[ ! -x "$GITEA_BRIDGE_SOURCE_SCRIPT" ]]; then
      if [[ -x "$SCRIPT_DIR/gitea-opkssh-authorized-keys" ]]; then
        GITEA_BRIDGE_SOURCE_SCRIPT="$SCRIPT_DIR/gitea-opkssh-authorized-keys"
      elif command -v gitea-opkssh-authorized-keys >/dev/null 2>&1; then
        GITEA_BRIDGE_SOURCE_SCRIPT="$(command -v gitea-opkssh-authorized-keys)"
      else
        err "Gitea OPKSSH bridge script is missing or not executable: $GITEA_BRIDGE_SOURCE_SCRIPT"
        echo "Install the flake package or run this script from the repository root."
        exit 1
      fi
    fi

    install -d -m 755 "$(dirname "$GITEA_BRIDGE_INSTALL_PATH")"
    install -m 755 "$GITEA_BRIDGE_SOURCE_SCRIPT" "$GITEA_BRIDGE_INSTALL_PATH"
    ok "Installed Gitea bridge: $GITEA_BRIDGE_INSTALL_PATH"

    if [[ -z "$GITEA_BINARY" ]]; then
      if command -v gitea >/dev/null 2>&1; then
        GITEA_BINARY="$(command -v gitea)"
      elif [[ -x /usr/local/bin/gitea ]]; then
        GITEA_BINARY="/usr/local/bin/gitea"
      else
        GITEA_BINARY="/usr/local/bin/gitea"
        warn "Could not auto-detect gitea binary; using $GITEA_BINARY. Override with --gitea-binary if needed."
      fi
    fi

    install -d -m 755 "$(dirname "$GITEA_BRIDGE_CONFIG")"
    cat >"$GITEA_BRIDGE_CONFIG" <<EOF
# Managed by UGA Manufacturing Living Labs OPKSSH setup.
GITEA_URL="$GITEA_URL"
GITEA_TOKEN_FILE="$GITEA_TOKEN_FILE"
GITEA_BINARY="$GITEA_BINARY"
GITEA_CONFIG="$GITEA_CONFIG"
GITEA_WORK_PATH="$GITEA_WORK_PATH"
GITEA_RUN_USER="$GITEA_RUN_USER"
GITEA_KEY_TITLE_PREFIX="opkssh-oidc"
GITEA_REQUIRE_VERIFIED_EMAIL="$GITEA_REQUIRE_VERIFIED_EMAIL"
GITEA_SYNTHETIC_KEY_READ_ONLY="$GITEA_SYNTHETIC_KEY_READ_ONLY"
OPKSSH_BINARY="$OPKSSH_PATH"
EOF
    chmod 640 "$GITEA_BRIDGE_CONFIG"
    chown root:opksshuser "$GITEA_BRIDGE_CONFIG"
    ok "Wrote $GITEA_BRIDGE_CONFIG"

    if [[ -f "$GITEA_TOKEN_FILE" ]]; then
      chown root:opksshuser "$GITEA_TOKEN_FILE" || warn "Could not chown $GITEA_TOKEN_FILE to root:opksshuser"
      chmod 640 "$GITEA_TOKEN_FILE" || warn "Could not chmod $GITEA_TOKEN_FILE to 640"
    else
      warn "Create $GITEA_TOKEN_FILE with a Gitea admin API token before testing OPKSSH Git auth."
    fi

    AUTHORIZED_KEYS_COMMAND="$GITEA_BRIDGE_INSTALL_PATH --config $GITEA_BRIDGE_CONFIG --principal %u --key-type %t --key %k"
    AUTHORIZED_KEYS_COMMAND_USER="$GITEA_RUN_USER"
  else
    AUTHORIZED_KEYS_COMMAND="$OPKSSH_PATH verify %u %k %t"
    AUTHORIZED_KEYS_COMMAND_USER="opksshuser"
  fi

  cat >"$SSHD_OPKSSH_CONFIG" <<EOF
# Managed by UGA Manufacturing Living Labs OPKSSH setup.
PubkeyAuthentication yes
AuthorizedKeysCommand $AUTHORIZED_KEYS_COMMAND
AuthorizedKeysCommandUser $AUTHORIZED_KEYS_COMMAND_USER
EOF

  chmod 644 "$SSHD_OPKSSH_CONFIG"
  ok "Wrote $SSHD_OPKSSH_CONFIG"
fi

# --- Providers setup (always runs) ---
info "Setting up providers file"

mkdir -p "$PROVIDERS_DIR"
chmod 755 "$PROVIDERS_DIR"

if [[ -f "$PROVIDERS_FILE" ]]; then
  BACKUP="${PROVIDERS_FILE}.backup.$(date +%Y%m%d-%H%M%S)"
  info "Backing up existing providers file"
  cp "$PROVIDERS_FILE" "$BACKUP"
  ok "Backup created: $BACKUP"
else
  info "Creating providers file"
  touch "$PROVIDERS_FILE"
fi

chmod 640 "$PROVIDERS_FILE"

if getent group opksshuser >/dev/null 2>&1; then
  chown root:opksshuser "$PROVIDERS_FILE"
else
  warn "Group opksshuser does not exist yet; leaving $PROVIDERS_FILE owned by root."
fi

info "Checking for existing provider entry"

if grep -Fq "$UGA_ISSUER" "$PROVIDERS_FILE"; then
  warn "Provider already exists:"
  grep -F "$UGA_ISSUER" "$PROVIDERS_FILE" || true
else
  echo "$UGA_PROVIDER_LINE" >>"$PROVIDERS_FILE"
  ok "Added provider:"
  echo "    $UGA_PROVIDER_LINE"
fi

if [[ -n "$GROUP_MAP" || -n "$ROLE_MAP" || -n "$EMAIL_MAP" ]]; then
  info "Applying Living Labs OPKSSH auth maps"

  if [[ ! -x "$AUTH_SYNC_SCRIPT" ]]; then
    if [[ -x "$SCRIPT_DIR/living-labs-auth-sync" ]]; then
      AUTH_SYNC_SCRIPT="$SCRIPT_DIR/living-labs-auth-sync"
    elif command -v living-labs-auth-sync >/dev/null 2>&1; then
      AUTH_SYNC_SCRIPT="$(command -v living-labs-auth-sync)"
    else
      err "Auth sync script is missing or not executable: $AUTH_SYNC_SCRIPT"
      echo "Install the flake package or run this script from the repository root."
      exit 1
    fi
  fi

  if [[ ! -x "$AUTH_SYNC_SCRIPT" ]]; then
    err "Auth sync script is not executable: $AUTH_SYNC_SCRIPT"
    exit 1
  fi

  AUTH_SYNC_ARGS=()
  if [[ -n "$GROUP_MAP" ]]; then
    AUTH_SYNC_ARGS+=(--group-map "$GROUP_MAP")
  fi
  if [[ -n "$ROLE_MAP" ]]; then
    AUTH_SYNC_ARGS+=(--role-map "$ROLE_MAP")
  fi
  if [[ -n "$EMAIL_MAP" ]]; then
    AUTH_SYNC_ARGS+=(--email-map "$EMAIL_MAP")
  fi

  "$AUTH_SYNC_SCRIPT" "${AUTH_SYNC_ARGS[@]}"
fi

FACTORY_AUTH_LINE="${FACTORY_USER} oidc:roles:${FACTORY_ACCESS_GROUP} ${UGA_ISSUER}"
GITEA_AUTH_LINE="${GITEA_RUN_USER} oidc:roles:${GITEA_ACCESS_ROLE} ${UGA_ISSUER}"

info "Ensuring factory shared-user authorization"

if [[ ! -f "$AUTH_ID_FILE" ]]; then
  touch "$AUTH_ID_FILE"
fi

chmod 640 "$AUTH_ID_FILE"

if getent group opksshuser >/dev/null 2>&1; then
  chown root:opksshuser "$AUTH_ID_FILE"
else
  warn "Group opksshuser does not exist yet; leaving $AUTH_ID_FILE owned by root."
fi

if grep -Fq "$FACTORY_AUTH_LINE" "$AUTH_ID_FILE"; then
  ok "Factory shared-user auth already exists:"
  echo "    $FACTORY_AUTH_LINE"
else
  echo "$FACTORY_AUTH_LINE" >>"$AUTH_ID_FILE"
  ok "Added factory shared-user auth:"
  echo "    $FACTORY_AUTH_LINE"
fi

if [[ "$CONFIGURE_GITEA_OPKSSH" == true ]]; then
  info "Ensuring Gitea OPKSSH authorization"

  if grep -Fq "$GITEA_AUTH_LINE" "$AUTH_ID_FILE"; then
    ok "Gitea OPKSSH auth already exists:"
    echo "    $GITEA_AUTH_LINE"
  else
    echo "$GITEA_AUTH_LINE" >>"$AUTH_ID_FILE"
    ok "Added Gitea OPKSSH auth:"
    echo "    $GITEA_AUTH_LINE"
  fi
fi

if [[ "$CONFIGURE_JUMP_HOST" == true ]]; then
  info "Configuring sshd jump-host forwarding policy"

  if [[ "$CREATE_FACTORY_USER" == true ]]; then
    if id "$FACTORY_USER" >/dev/null 2>&1; then
      ok "Shared bastion user already exists: $FACTORY_USER"
    else
      info "Creating shared bastion user: $FACTORY_USER"

      if command -v useradd >/dev/null 2>&1; then
        useradd --system --create-home --shell /bin/bash "$FACTORY_USER"
      else
        err "useradd was not found. Create user '$FACTORY_USER' manually or rerun with --no-create-factory-user."
        exit 1
      fi

      ok "Created shared bastion user: $FACTORY_USER"
    fi
  fi

  if [[ ! -d "$SSHD_CONFIG_DIR" ]]; then
    install -d -m 755 "$SSHD_CONFIG_DIR"
  fi

  NORMALIZED_PRINCIPALS="$(printf '%s\n' "$JUMP_PRINCIPALS" | tr ' ' ',' | tr -s ',')"

  if [[ "$INSTALL_NO_SHELL_COMMAND" == true ]]; then
    if [[ ! -x "$NO_SHELL_SOURCE_SCRIPT" ]]; then
      if [[ -x "$SCRIPT_DIR/factory-ssh-no-shell" ]]; then
        NO_SHELL_SOURCE_SCRIPT="$SCRIPT_DIR/factory-ssh-no-shell"
      elif command -v factory-ssh-no-shell >/dev/null 2>&1; then
        NO_SHELL_SOURCE_SCRIPT="$(command -v factory-ssh-no-shell)"
      else
        err "No-shell command script is missing or not executable: $NO_SHELL_SOURCE_SCRIPT"
        echo "Install the flake package or run this script from the repository root."
        exit 1
      fi
    fi

    install -d -m 755 "$(dirname "$NO_SHELL_INSTALL_PATH")"
    install -m 755 "$NO_SHELL_SOURCE_SCRIPT" "$NO_SHELL_INSTALL_PATH"
    ok "Installed no-shell command: $NO_SHELL_INSTALL_PATH"
    FORCE_COMMAND_LINE="    ForceCommand $NO_SHELL_INSTALL_PATH"
  else
    FORCE_COMMAND_LINE=""
  fi

  cat >"$SSHD_JUMP_CONFIG" <<EOF
# Managed by UGA Manufacturing Living Labs OPKSSH setup.
# These users can be used as ProxyJump entry points into lab networks.
Match User $NORMALIZED_PRINCIPALS
    AllowTcpForwarding yes
    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    ExposeAuthInfo yes
    SetEnv OPKSSH_IDENTIFIED_USER="$FACTORY_USER"
$FORCE_COMMAND_LINE
    PermitOpen $PERMIT_OPEN
    ClientAliveInterval $CLIENT_ALIVE_INTERVAL
    ClientAliveCountMax $CLIENT_ALIVE_COUNT_MAX
EOF

  chmod 644 "$SSHD_JUMP_CONFIG"
  ok "Wrote $SSHD_JUMP_CONFIG"

  if command -v sshd >/dev/null 2>&1; then
    if sshd -t; then
      ok "sshd configuration validates"
      if command -v systemctl >/dev/null 2>&1; then
        warn "Reload sshd when ready:"
        echo "  sudo systemctl reload sshd"
      else
        warn "Reload sshd with your platform's service manager when ready."
      fi
    else
      err "sshd configuration did not validate. Review $SSHD_JUMP_CONFIG before reloading sshd."
      exit 1
    fi
  else
    warn "sshd command not found; could not validate SSH configuration."
  fi
fi

if [[ "$CONFIGURE_SSHD_OPKSSH" == true && "$CONFIGURE_JUMP_HOST" == false ]]; then
  if command -v sshd >/dev/null 2>&1; then
    if sshd -t; then
      ok "sshd configuration validates"
      if command -v systemctl >/dev/null 2>&1; then
        warn "Reload sshd when ready:"
        echo "  sudo systemctl reload sshd"
      else
        warn "Reload sshd with your platform's service manager when ready."
      fi
    else
      err "sshd configuration did not validate. Review $SSHD_OPKSSH_CONFIG before reloading sshd."
      exit 1
    fi
  else
    warn "sshd command not found; could not validate SSH configuration."
  fi
fi

echo
echo "${BOLD}${GREEN}Done.${RESET}"
echo
echo "Providers file:"
echo "  $PROVIDERS_FILE"
echo
echo "sshd OPKSSH:"
if [[ "$CONFIGURE_SSHD_OPKSSH" == true ]]; then
  echo "  configured: $SSHD_OPKSSH_CONFIG"
  if [[ "$CONFIGURE_GITEA_OPKSSH" == true ]]; then
    echo "  gitea bridge: $GITEA_BRIDGE_INSTALL_PATH"
    echo "  gitea bridge config: $GITEA_BRIDGE_CONFIG"
    echo "  gitea SSH user: $GITEA_RUN_USER"
    echo "  gitea access role: $GITEA_ACCESS_ROLE"
  fi
else
  echo "  not configured"
fi
echo
echo "Mode:"
if [[ "$PROVIDERS_ONLY" == true ]]; then
  echo "  providers-only"
else
  echo "  full server setup"
fi
echo
echo "Jump host:"
if [[ "$CONFIGURE_JUMP_HOST" == true ]]; then
  echo "  configured: $SSHD_JUMP_CONFIG"
  echo "  shared user: $FACTORY_USER"
  echo "  Entra access group: $FACTORY_ACCESS_GROUP"
  echo "  keepalive: ClientAliveInterval=$CLIENT_ALIVE_INTERVAL ClientAliveCountMax=$CLIENT_ALIVE_COUNT_MAX"
else
  echo "  not configured (use --configure-jump-host to enable ssh -J forwarding users)"
fi
