#!/usr/bin/env bash
set -euo pipefail

RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
BLUE=$'\033[34m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

info() { echo "${BLUE}==>${RESET} $*"; }
ok() { echo "${GREEN}OK:${RESET} $*"; }
warn() { echo "${YELLOW}WARN:${RESET} $*"; }
err() { echo "${RED}ERROR:${RESET} $*" >&2; }

CONFIG_DIR="$HOME/.opk"
CONFIG_FILE="$CONFIG_DIR/config.yml"
SSH_DIR="$HOME/.ssh"
SSH_CONFIG="$SSH_DIR/config"
SSH_KNOWN_HOSTS="$SSH_DIR/known_hosts"

FACTORY_HOST="factory.uga.edu"
FACTORY_ALIAS="factory"
INTERNAL_PATTERN="*.factory.internal"
FACTORY_USER="factory"
REMOTE_USER="${USER}"
UPDATE_SSH_CONFIG=true
TRUST_FACTORY_HOST=true
SERVER_ALIVE_INTERVAL="20"
SERVER_ALIVE_COUNT_MAX="6"

usage() {
  echo "${BOLD}Usage:${RESET} $0 [options]"
  echo
  echo "Options:"
  echo "  --factory-host HOST       Public SSH bastion host (default: factory.uga.edu)"
  echo "  --factory-alias ALIAS     Local SSH alias for the bastion (default: factory)"
  echo "  --factory-user USER       Remote user for the bastion (default: factory)"
  echo "  --internal-pattern GLOB   Hosts reached through ProxyJump (default: *.factory.internal)"
  echo "  --remote-user USER        Remote user for internal hosts (default: current user)"
  echo "  --linux-user USER         Set both factory and internal remote users"
  echo "  --server-alive-interval N Seconds between client keepalives (default: 20)"
  echo "  --server-alive-count N    Missed keepalives before disconnect (default: 6)"
  echo "  --no-trust-factory-host   Do not add the factory host to ~/.ssh/known_hosts"
  echo "  --no-ssh-config           Only write OPKSSH config; skip ~/.ssh/config"
  echo "  -h, --help                Show this help message"
}

require_value() {
  local option="$1"
  local value="${2:-}"

  if [[ -z "$value" ]]; then
    err "$option requires a value"
    exit 1
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --factory-host)
    require_value "$1" "${2:-}"
    FACTORY_HOST="$2"
    shift 2
    ;;
  --factory-alias)
    require_value "$1" "${2:-}"
    FACTORY_ALIAS="$2"
    shift 2
    ;;
  --factory-user)
    require_value "$1" "${2:-}"
    FACTORY_USER="$2"
    shift 2
    ;;
  --internal-pattern)
    require_value "$1" "${2:-}"
    INTERNAL_PATTERN="$2"
    shift 2
    ;;
  --remote-user)
    require_value "$1" "${2:-}"
    REMOTE_USER="$2"
    shift 2
    ;;
  --linux-user)
    require_value "$1" "${2:-}"
    FACTORY_USER="$2"
    REMOTE_USER="$2"
    shift 2
    ;;
  --server-alive-interval)
    require_value "$1" "${2:-}"
    SERVER_ALIVE_INTERVAL="$2"
    shift 2
    ;;
  --server-alive-count)
    require_value "$1" "${2:-}"
    SERVER_ALIVE_COUNT_MAX="$2"
    shift 2
    ;;
  --no-trust-factory-host)
    TRUST_FACTORY_HOST=false
    shift
    ;;
  --no-ssh-config)
    UPDATE_SSH_CONFIG=false
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    err "Unknown argument: $1"
    echo
    usage
    exit 1
    ;;
  esac
done

info "Creating OPKSSH config directory"
mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"
ok "Config directory ready: $CONFIG_DIR"

if [[ -f "$CONFIG_FILE" ]]; then
  BACKUP="$CONFIG_FILE.backup.$(date +%Y%m%d-%H%M%S)"
  warn "Existing config found. Backing it up to:"
  echo "     $BACKUP"
  cp "$CONFIG_FILE" "$BACKUP"
fi

info "Writing UGA ArchPass OPKSSH config"

cat >"$CONFIG_FILE" <<'YAML'
---
default_provider: uga
providers:
  - alias: uga
    issuer: https://login.microsoftonline.com/a8216c1e-4d63-4352-8c3b-50fa1f1475b1/v2.0
    client_id: 7f331a0a-da1a-4e13-8df0-e9baba02ed86
    scopes: openid profile email offline_access
    access_type: offline
    prompt: consent
    redirect_uris:
      - http://localhost:3000/login-callback
      - http://localhost:10001/login-callback
      - http://localhost:11110/login-callback
YAML

chmod 600 "$CONFIG_FILE"
ok "Wrote config: $CONFIG_FILE"

if [[ "$UPDATE_SSH_CONFIG" == true || "$TRUST_FACTORY_HOST" == true ]]; then
  mkdir -p "$SSH_DIR"
  chmod 700 "$SSH_DIR"
fi

if [[ "$TRUST_FACTORY_HOST" == true ]]; then
  info "Adding $FACTORY_HOST to SSH known hosts"

  if ! command -v ssh-keyscan >/dev/null 2>&1; then
    err "ssh-keyscan was not found on PATH"
    exit 1
  fi

  touch "$SSH_KNOWN_HOSTS"
  chmod 600 "$SSH_KNOWN_HOSTS"

  KNOWN_HOSTS_BACKUP="$SSH_KNOWN_HOSTS.backup.$(date +%Y%m%d-%H%M%S)"
  cp "$SSH_KNOWN_HOSTS" "$KNOWN_HOSTS_BACKUP"

  KEYSCAN_OUTPUT="$(mktemp)"
  cleanup_keyscan() {
    rm -f "$KEYSCAN_OUTPUT"
  }
  trap cleanup_keyscan EXIT

  # Collect the host's currently advertised SSH host keys.
  if ! ssh-keyscan \
    -T 10 \
    -H \
    -t ed25519,ecdsa,rsa \
    "$FACTORY_HOST" >"$KEYSCAN_OUTPUT" 2>/dev/null; then
    err "Could not retrieve SSH host keys from $FACTORY_HOST"
    exit 1
  fi

  if [[ ! -s "$KEYSCAN_OUTPUT" ]]; then
    err "No SSH host keys were returned by $FACTORY_HOST"
    exit 1
  fi

  # Remove any existing entry for this hostname before adding the current keys.
  # ssh-keygen -R handles both plain and hashed known_hosts entries.
  ssh-keygen \
    -f "$SSH_KNOWN_HOSTS" \
    -R "$FACTORY_HOST" >/dev/null 2>&1 || true

  cat "$KEYSCAN_OUTPUT" >>"$SSH_KNOWN_HOSTS"
  chmod 600 "$SSH_KNOWN_HOSTS"

  rm -f "$KEYSCAN_OUTPUT"
  trap - EXIT

  ok "Trusted SSH host keys for: $FACTORY_HOST"
  echo "     Backup: $KNOWN_HOSTS_BACKUP"
fi

if [[ "$UPDATE_SSH_CONFIG" == true ]]; then
  info "Configuring SSH ProxyJump entries"
  touch "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"

  START_MARKER="# >>> UGA Manufacturing Living Labs OPKSSH"
  END_MARKER="# <<< UGA Manufacturing Living Labs OPKSSH"
  TMP_CONFIG="$(mktemp)"

  cleanup_ssh_config() {
    rm -f "$TMP_CONFIG"
  }
  trap cleanup_ssh_config EXIT

  if grep -Fq "$START_MARKER" "$SSH_CONFIG"; then
    awk -v start="$START_MARKER" -v end="$END_MARKER" '
      $0 == start { skip = 1; next }
      $0 == end { skip = 0; next }
      skip != 1 { print }
    ' "$SSH_CONFIG" >"$TMP_CONFIG"
  else
    cp "$SSH_CONFIG" "$TMP_CONFIG"
  fi

  {
    cat "$TMP_CONFIG"
    if [[ -s "$TMP_CONFIG" ]]; then
      echo
    fi
    echo "$START_MARKER"
    echo "Host $FACTORY_ALIAS"
    echo "  HostName $FACTORY_HOST"
    echo "  User $FACTORY_USER"
    echo "  IdentitiesOnly yes"
    echo "  IdentityFile ~/.ssh/id_ecdsa"
    echo "  PreferredAuthentications publickey"
    echo "  PubkeyAuthentication yes"
    echo "  PasswordAuthentication no"
    echo "  KbdInteractiveAuthentication no"
    echo "  BatchMode yes"
    echo "  ServerAliveInterval $SERVER_ALIVE_INTERVAL"
    echo "  ServerAliveCountMax $SERVER_ALIVE_COUNT_MAX"
    echo
    echo "Host $INTERNAL_PATTERN"
    echo "  User $REMOTE_USER"
    echo "  ProxyJump $FACTORY_ALIAS"
    echo "  IdentitiesOnly yes"
    echo "  IdentityFile ~/.ssh/id_ecdsa"
    echo "  PreferredAuthentications publickey"
    echo "  PubkeyAuthentication yes"
    echo "  PasswordAuthentication no"
    echo "  KbdInteractiveAuthentication no"
    echo "  BatchMode yes"
    echo "  ServerAliveInterval $SERVER_ALIVE_INTERVAL"
    echo "  ServerAliveCountMax $SERVER_ALIVE_COUNT_MAX"
    echo "$END_MARKER"
  } >"$SSH_CONFIG"

  rm -f "$TMP_CONFIG"
  trap - EXIT

  ok "Updated SSH config: $SSH_CONFIG"
fi

info "Checking for opkssh on PATH"

if command -v opkssh >/dev/null 2>&1; then
  OPKSSH_PATH="$(command -v opkssh)"
  ok "Found opkssh: $OPKSSH_PATH"

  echo
  echo "${BOLD}${GREEN}Setup complete.${RESET}"
  echo
  echo "Next step:"
  echo "  opkssh login uga"
  echo
  echo "Example jump usage:"
  echo "  ssh -J $FACTORY_ALIAS $REMOTE_USER@internal-host"
  echo "  ssh $REMOTE_USER@<host matching $INTERNAL_PATTERN>"
else
  warn "opkssh was not found on your PATH."

  echo
  echo "${BOLD}Install OPKSSH first:${RESET}"
  echo "  https://github.com/openpubkey/opkssh"
  echo
  echo "After installing, open a new terminal and run:"
  echo "  opkssh login uga"
  echo
  echo "${YELLOW}Config was still created successfully.${RESET}"
fi
