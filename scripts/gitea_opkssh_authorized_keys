#!/usr/bin/env python3
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request


DEFAULT_CONFIG = "/etc/opk/gitea-opkssh.env"
EMAIL_RE = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
AUTHORIZED_KEYS_RE = re.compile(
    r"^(?:(?P<options>\S+)\s+)?(?P<key_type>(?:ssh|ecdsa|sk)-\S+)\s+(?P<key_body>\S+)(?P<comment>.*)$"
)


def load_env(path):
    config = {
        "GITEA_URL": "http://127.0.0.1:80",
        "GITEA_TOKEN_FILE": "/etc/opk/gitea-token",
        "GITEA_BINARY": "/usr/local/bin/gitea",
        "GITEA_CONFIG": "/etc/gitea/app.ini",
        "GITEA_WORK_PATH": "",
        "GITEA_RUN_USER": "git",
        "GITEA_KEY_TITLE_PREFIX": "opkssh-oidc",
        "GITEA_REQUIRE_VERIFIED_EMAIL": "false",
        "GITEA_SYNTHETIC_KEY_READ_ONLY": "false",
        "OPKSSH_BINARY": "/usr/local/bin/opkssh",
    }

    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as handle:
            for raw_line in handle:
                line = raw_line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                config[key.strip()] = value.strip().strip('"').strip("'")

    return config


def truthy(value):
    return value.lower() in ("1", "true", "yes", "on")


def gitea_base_args(config):
    args = [config["GITEA_BINARY"]]
    if config.get("GITEA_CONFIG"):
        args.extend(["--config", config["GITEA_CONFIG"]])
    if config.get("GITEA_WORK_PATH"):
        args.extend(["--work-path", config["GITEA_WORK_PATH"]])
    return args


def try_gitea_static_key(config, principal, key_type, key):
    args = gitea_base_args(config) + [
        "keys",
        "-e",
        config["GITEA_RUN_USER"],
        "-u",
        principal,
        "-t",
        key_type,
        "-k",
        key,
    ]

    try:
        result = subprocess.run(args, check=False, text=True, capture_output=True)
    except OSError:
        return False

    output = result.stdout.strip()
    if result.returncode == 0 and output:
        print(output)
        return True

    return False


def run_opkssh_verify(config, principal, key_type, key, emit=False):
    result = subprocess.run(
        [config["OPKSSH_BINARY"], "verify", principal, key, key_type],
        check=False,
        text=True,
        capture_output=True,
    )
    if emit and result.returncode == 0 and result.stdout:
        print(result.stdout, end="")
    return result.returncode == 0


def opkssh_authorized_keys_line(config, principal, key_type, key):
    result = subprocess.run(
        [config["OPKSSH_BINARY"], "verify", principal, key, key_type],
        check=False,
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        return ""

    for line in result.stdout.splitlines():
        stripped = line.strip()
        if stripped:
            return stripped

    return ""


def extract_cert_email(key_type, key):
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False) as handle:
        handle.write(f"{key_type} {key}\n")
        cert_path = handle.name

    try:
        result = subprocess.run(
            ["ssh-keygen", "-L", "-f", cert_path],
            check=True,
            text=True,
            capture_output=True,
        )
    finally:
        try:
            os.unlink(cert_path)
        except FileNotFoundError:
            pass

    for line in result.stdout.splitlines():
        stripped = line.strip()
        if stripped.startswith("Key ID:"):
            value = stripped.split(":", 1)[1].strip().strip('"')
            if EMAIL_RE.match(value):
                return value

    raise RuntimeError("OPKSSH certificate Key ID did not contain an email address")


def read_token(config):
    with open(config["GITEA_TOKEN_FILE"], "r", encoding="utf-8") as handle:
        return handle.read().strip()


def api_request(config, method, path, body=None):
    token = read_token(config)
    base = config["GITEA_URL"].rstrip("/")
    data = None
    headers = {
        "Accept": "application/json",
        "Authorization": f"token {token}",
    }

    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"

    request = urllib.request.Request(
        base + path,
        data=data,
        method=method,
        headers=headers,
    )

    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            payload = response.read()
            if not payload:
                return None
            return json.loads(payload.decode("utf-8"))
    except urllib.error.HTTPError as err:
        payload = err.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"Gitea API {method} {path} failed: HTTP {err.code}: {payload}") from err


def find_gitea_username(config, email):
    query = urllib.parse.urlencode({"q": email, "limit": "10"})
    results = api_request(config, "GET", f"/api/v1/admin/emails/search?{query}") or []
    require_verified = truthy(config["GITEA_REQUIRE_VERIFIED_EMAIL"])

    matches = []
    for entry in results:
        entry_email = str(entry.get("email", ""))
        if entry_email.lower() != email.lower():
            continue
        if require_verified and not entry.get("verified", False):
            continue
        username = entry.get("username")
        if username:
            matches.append(username)

    unique = sorted(set(matches))
    if len(unique) != 1:
        raise RuntimeError(f"expected exactly one Gitea user for {email}, found {len(unique)}")

    return unique[0]


def list_user_keys(config, username):
    quoted = urllib.parse.quote(username, safe="")
    try:
        return api_request(config, "GET", f"/api/v1/users/{quoted}/keys") or []
    except RuntimeError:
        return []


def make_inert_public_key(title):
    with tempfile.TemporaryDirectory() as tmpdir:
        key_path = os.path.join(tmpdir, "synthetic")
        subprocess.run(
            ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", title, "-f", key_path],
            check=True,
            text=True,
            capture_output=True,
        )
        with open(key_path + ".pub", "r", encoding="utf-8") as handle:
            return handle.read().strip()


def ensure_gitea_key(config, username, email):
    title = f"{config['GITEA_KEY_TITLE_PREFIX']}:{email.lower()}"

    for key in list_user_keys(config, username):
        if key.get("title") == title and key.get("id") is not None:
            return int(key["id"])

    quoted = urllib.parse.quote(username, safe="")
    public_key = make_inert_public_key(title)
    created = api_request(
        config,
        "POST",
        f"/api/v1/admin/users/{quoted}/keys",
        {
            "title": title,
            "key": public_key,
            "read_only": truthy(config["GITEA_SYNTHETIC_KEY_READ_ONLY"]),
        },
    )

    if created and created.get("id") is not None:
        return int(created["id"])

    for key in list_user_keys(config, username):
        if key.get("title") == title and key.get("id") is not None:
            return int(key["id"])

    raise RuntimeError(f"failed to ensure synthetic Gitea key for {username}")


def authorized_keys_command(config, key_id):
    args = gitea_base_args(config) + ["serv", f"key-{key_id}"]
    command = shlex.join(args)
    return command.replace("\\", "\\\\").replace('"', '\\"')


def emit_gitea_command_for_opkssh_line(config, opkssh_line, key_id):
    command = authorized_keys_command(config, key_id)
    match = AUTHORIZED_KEYS_RE.match(opkssh_line)
    if not match:
        raise RuntimeError("opkssh verify did not emit a usable authorized_keys line")

    forced_options = [
        f'command="{command}"',
        "no-port-forwarding",
        "no-X11-forwarding",
        "no-agent-forwarding",
        "no-pty",
        "no-user-rc",
    ]
    existing_options = match.group("options")
    if existing_options:
        forced_options.append(existing_options)

    options = ",".join(forced_options)
    key_fields = f"{match.group('key_type')} {match.group('key_body')}{match.group('comment')}"

    print(f"{options} {key_fields}")


def main():
    parser = argparse.ArgumentParser(description="Gitea + OPKSSH AuthorizedKeysCommand bridge")
    parser.add_argument("--config", default=DEFAULT_CONFIG)
    parser.add_argument("--principal", required=True)
    parser.add_argument("--key-type", required=True)
    parser.add_argument("--key", required=True)
    args = parser.parse_args()

    config = load_env(args.config)
    principal = args.principal

    if principal == config["GITEA_RUN_USER"]:
        if try_gitea_static_key(config, principal, args.key_type, args.key):
            return 0

        if not args.key_type.endswith("-cert-v01@openssh.com"):
            return 0

        try:
            opkssh_line = opkssh_authorized_keys_line(config, principal, args.key_type, args.key)
            if not opkssh_line:
                return 0
            email = extract_cert_email(args.key_type, args.key)
            username = find_gitea_username(config, email)
            key_id = ensure_gitea_key(config, username, email)
            emit_gitea_command_for_opkssh_line(config, opkssh_line, key_id)
        except Exception as exc:
            print(f"gitea-opkssh: {exc}", file=sys.stderr)
            return 0

        return 0

    if run_opkssh_verify(config, principal, args.key_type, args.key, emit=True):
        return 0

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
